@prefix ex: <http://example.org/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Artificial_Lifeforms a rdfs:Class ;
    rdfs:label "Artificial Lifeforms" ;
    rdfs:subClassOf ex:Species .

ex:Borg_Cubes a rdfs:Class ;
    rdfs:label "Borg Cubes" ;
    rdfs:subClassOf ex:Starships .

ex:Cardassian_Galor-Class_Ships a rdfs:Class ;
    rdfs:label "Cardassian Galor-Class Ships" ;
    rdfs:subClassOf ex:Starships .

ex:Class_M_Planets a rdfs:Class ;
    rdfs:label "Class M Planets" ;
    rdfs:subClassOf ex:Planets .

ex:Colony_Worlds a rdfs:Class ;
    rdfs:label "Colony Worlds" ;
    rdfs:subClassOf ex:Planets .

ex:Communication_Systems a rdfs:Class ;
    rdfs:label "Communication Systems" ;
    rdfs:subClassOf ex:Technology .

ex:Criminal_Syndicates a rdfs:Class ;
    rdfs:label "Criminal Syndicates" ;
    rdfs:subClassOf ex:Organizations .

ex:Energy-Based_Entities a rdfs:Class ;
    rdfs:label "Energy-Based Entities" ;
    rdfs:subClassOf ex:Species .

ex:Energy_Shields a rdfs:Class ;
    rdfs:label "Energy Shields" ;
    rdfs:subClassOf ex:Technology .

ex:Federation_Organizations a rdfs:Class ;
    rdfs:label "Federation Organizations" ;
    rdfs:subClassOf ex:Organizations .

ex:Federation_Planets a rdfs:Class ;
    rdfs:label "Federation Planets" ;
    rdfs:subClassOf ex:Planets .

ex:Federation_Starships a rdfs:Class ;
    rdfs:label "Federation Starships" ;
    rdfs:subClassOf ex:Starships .

ex:Humanoids a rdfs:Class ;
    rdfs:label "Humanoids" ;
    rdfs:subClassOf ex:Species .

ex:Klingon_Starships a rdfs:Class ;
    rdfs:label "Klingon Starships" ;
    rdfs:subClassOf ex:Starships .

ex:Medical_Devices a rdfs:Class ;
    rdfs:label "Medical Devices" ;
    rdfs:subClassOf ex:Technology .

ex:Neutral_Zone_Planets a rdfs:Class ;
    rdfs:label "Neutral Zone Planets" ;
    rdfs:subClassOf ex:Planets .

ex:Non-Federation_Organizations a rdfs:Class ;
    rdfs:label "Non-Federation Organizations" ;
    rdfs:subClassOf ex:Organizations .

ex:Non-Federation_Planets a rdfs:Class ;
    rdfs:label "Non-Federation Planets" ;
    rdfs:subClassOf ex:Planets .

ex:Non-Humanoids a rdfs:Class ;
    rdfs:label "Non-Humanoids" ;
    rdfs:subClassOf ex:Species .

ex:Organizations a ex:Andoria,
        ex:Trill,
        rdfs:Class ;
    rdfs:label "Organizations" .

ex:Planets a ex:Andorians,
        ex:Federation_Diplomatic_Corps,
        ex:Federation_Science_Bureau,
        rdfs:Class ;
    rdfs:label "Planets" .

ex:Propulsion_Systems a rdfs:Class ;
    rdfs:label "Propulsion Systems" ;
    rdfs:subClassOf ex:Technology .

ex:Religious_Orders a rdfs:Class ;
    rdfs:label "Religious Orders" ;
    rdfs:subClassOf ex:Organizations .

ex:Romulan_Warbirds a rdfs:Class ;
    rdfs:label "Romulan Warbirds" ;
    rdfs:subClassOf ex:Starships .

ex:Species a ex:Class_M_Planets,
        rdfs:Class ;
    rdfs:label "Species" .

ex:Starships a ex:Coaxial_Warp_Drive,
        ex:Energy_Shields,
        ex:Quantum_Slipstream_Drive,
        rdfs:Class ;
    rdfs:label "Starships" .

ex:Technology a ex:Borg_Cubes,
        ex:Cardassian_Galor-Class_Ships,
        ex:Criminal_Syndicates,
        ex:Farius_Prime_Underworld,
        ex:Keldon-Refit_Prototype,
        ex:Ktinga,
        ex:Mogai-class_Warbird,
        ex:Nausicaan_Raiders,
        ex:Romulan_Warbirds,
        ex:Scimitar-class_Warbird,
        ex:TVaro-class_Warbird,
        ex:Tactical_Cube,
        ex:USS_Defiant,
        ex:Valdore-type_Warbird,
        ex:Vorcha,
        rdfs:Class ;
    rdfs:label "Technology" .

ex:Temporal_Organizations a rdfs:Class ;
    rdfs:label "Temporal Organizations" ;
    rdfs:subClassOf ex:Organizations .

ex:Transdimensional_Beings a rdfs:Class ;
    rdfs:label "Transdimensional Beings" ;
