@prefix ex: <http://example.org/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix related: <http://example.org/ontology/related/> .

ex:costume_design rdfs:label "costume design" ;
    rdfs:subClassOf ex:Costuming .

ex:captain rdfs:label "captain" ;
    related:to ex:starship ;
    rdfs:subClassOf ex:Spacecraft .

ex:starship rdfs:label "starship" ;
    related:to ex:captain ;
    rdfs:subClassOf ex:Spacecraft .

ex:Bajoran rdfs:label "Bajoran" ;
    related:to ex:Q_Continuum,
        ex:Romulan,
        ex:Trek_fandom ;
    rdfs:subClassOf ex:Star_Trek_Lore .

ex:Q_Continuum rdfs:label "Q Continuum" ;
    related:to ex:Bajoran,
        ex:Romulan,
        ex:Trek_fandom ;
    rdfs:subClassOf ex:Star_Trek_Lore .

ex:Romulan rdfs:label "Romulan" ;
    related:to ex:Bajoran,
        ex:Q_Continuum,
        ex:Trek_fandom ;
    rdfs:subClassOf ex:Star_Trek_Lore .

ex:Trek_fandom rdfs:label "Trek fandom" ;
    related:to ex:Bajoran,
        ex:Q_Continuum,
        ex:Romulan ;
    rdfs:subClassOf ex:Star_Trek_Lore .

ex:Federation rdfs:label "Federation" ;
    related:to ex:Starfleet,
        ex:alien_races,
        ex:exploration,
        ex:holodeck,
        ex:phaser,
        ex:science_fiction,
        ex:space_opera,
        ex:the_Prime_Directive,
        ex:time_travel,
        ex:transporter,
        ex:voyage,
        ex:warp_drive ;
    rdfs:subClassOf ex:Science_Fiction_Universe .

