ex:Starfleet_Personnel a rdfs:Class ;
    rdfs:label "Starfleet Personnel" .

ex:Starfleet_Science_Division a rdfs:Class ;
    rdfs:label "Starfleet Science Division" ;
    rdfs:subClassOf ex:Starfleet .

ex:Starfleet_Technology a rdfs:Class ;
    rdfs:label "Starfleet Technology" .

ex:Starfleet_Vessels a rdfs:Class ;
    rdfs:label "Starfleet Vessels" .

ex:Starship_Classes a ex:Hectate-class_Battlecruiser,
        ex:QongmeH-class_Battlecruiser,
        ex:USS_Enterprise-D,
        ex:USS_Excelsior-B,
        rdfs:Class ;
    rdfs:label "Starship Classes" .

ex:Subspace_Communicator a rdfs:Class ;
    rdfs:label "Subspace Communicator" ;
    rdfs:subClassOf ex:Technology .

ex:Technology a ex:Bonaire_Class,
        ex:Sovereign_Class,
        ex:USS_Enterprise-D,
        rdfs:Class ;
